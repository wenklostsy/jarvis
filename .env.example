# JARVIS — exemplo seguro; não contém credenciais reais.
# npm start/bridge carregam .env; Vite também lê .env.local.
# .env.local não é carregado automaticamente pelo bridge Node.
JARVIS_BRAIN=ollama
JARVIS_LOCAL_MODEL=qwen3.5:4b
# JARVIS_MODEL=
# JARVIS_EFFORT=high
# Loopback obrigatório. Frontend usa proxy /bridge na mesma origem.
# JARVIS_BRIDGE_PORT=8787
# PORT=5173
# Defaults exatos: HTTP localhost/127.0.0.1 nas portas 5173 e 4173.
# Origins adicionais somente locais e exatas, separadas por vírgula.
# JARVIS_ALLOWED_ORIGINS=
# Clientes sem Origin ainda precisam de cookie de sessão.
# JARVIS_ALLOW_NO_ORIGIN=0
# Imagens: .jarvis/media; não há acesso implícito a home/temp.
# Acrescente somente pastas específicas e confiáveis.
# JARVIS_FILE_ROOTS=
# Compatibilidade: nunca libera shell, escrita arbitrária ou ferramentas desconhecidas.
# JARVIS_ALLOW_WRITES=0
# JARVIS_OLLAMA_PATH=

# Secrets opcionais somente no bridge.
GEMINI_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# JARVIS_VOICE_ID=

# Configuração pública.
VITE_BACKEND=bridge
VITE_TTS_ENGINE=system
# VITE_BRIDGE_URL=
# VITE_KOKORO_VOICE=bm_george
# VITE_USE_ELEVENLABS=false
# VITE_ELEVENLABS_VOICE_ID=

# Legado: opt-in explícito para enviar secrets ao navegador/bundle.
# Prefira os providers do bridge. Não habilite ao compartilhar/publicar.
# VITE_ALLOW_BROWSER_SECRETS=0
# VITE_ANTHROPIC_API_KEY=
# VITE_ELEVENLABS_API_KEY=
# VITE_PICOVOICE_ACCESS_KEY=
# VITE_ZAPIER_MCP_URL=
# VITE_PIPEDREAM_MCP_URL=
# VITE_NOTION_TOKEN=
# VITE_LINEAR_TOKEN=
# VITE_GITHUB_TOKEN=
# VITE_STRIPE_TOKEN=
# VITE_SENTRY_TOKEN=
# VITE_HOMEASSISTANT_MCP_URL=
# VITE_HOMEASSISTANT_TOKEN=
